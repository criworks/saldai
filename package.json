{
  "name": "saldai",
  "version": "1.0.0",
  "description": "Saldai",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "workspaces": [
    "packages/*",
    "web",
    "mobile",
    "api"
  ],
  "scripts": {
    "api": "npm run dev --prefix api",
    "web": "npm run dev --prefix web",
    "dev": "npm run api & npm run web",
    "cli": "npm run cli --prefix api",
    "test": "npm test --prefix packages/core && npm test --prefix api && npm test --prefix mobile",
    "lint": "npm run lint --prefix web",
    "typecheck": "npm run typecheck --prefix mobile",
    "tokens:css": "npm run tokens:css --prefix mobile",
    "tokens:css:check": "npm run tokens:css:check --prefix mobile",
    "tailwind:content:check": "npm run tailwind:content:check --prefix mobile",
    "changelog:check": "node scripts/verificar-changelogs.mjs"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.3"
  }
}
