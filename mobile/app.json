{
  "expo": {
    "name": "Saldai",
    "slug": "saldai",
    "scheme": "saldai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111217"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crirun.saldai"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.crirun.saldai"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "cri.run",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ff740251-bb4b-4e33-9142-f3b00bd3ad46"
      }
    }
  }
}
