# Variables de la app mobile. Copiar a `mobile/.env` y rellenar con los valores
# reales, que no se versionan.
#
# Las tres primeras son obligatorias: sin ellas la app no puede autenticar ni
# leer gastos. El prefijo EXPO_PUBLIC_ significa que quedan dentro del bundle,
# así que acá no va nada que sea realmente secreto: la anon key de Supabase está
# pensada para vivir en el cliente, protegida por las políticas RLS de la tabla.
#
# Para un build de EAS (`preview` o `production`) no alcanza este archivo: hay
# que crear las mismas variables en el dashboard de Expo, en Environment
# variables, en el environment que declara cada perfil de `eas.json`. En un
# development build no hacen falta allá, porque el bundle lo sirve tu máquina y
# toma este archivo.

# URL de la API. En producción es el servicio de Render.
EXPO_PUBLIC_API_URL=https://tu-api.onrender.com

# Proyecto de Supabase: Settings → API en el dashboard.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Opcional. En "true" la app no toca el backend real y usa los mocks de
# `services/api.ts`, útil para revisar estados de UI. Dejar sin definir salvo
# que estés probando eso.
# EXPO_PUBLIC_USE_MOCKS=false
