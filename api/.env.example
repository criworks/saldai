SUPABASE_URL=project_url
SUPABASE_ANON_KEY=project_anon_key
PORT=3000

NEXT_FRONTEND_DEPLOY_URL=deploy-url
NEXT_FRONTEND_LOCAL_URL=local-url

# Resend Email Integration
RESEND_API_KEY=re_your_api_key

# Direcciones de origen por tipo
RESEND_EMAIL_NOREPLY=email@example.com
RESEND_EMAIL_HOLA=email@example.com
RESEND_EMAIL_FEEDBACK=email@example.com

# Nombres visibles en el cliente de correo
RESEND_NAME_APP=Name
RESEND_NAME_MARKETING=Name

# Reporte de errores (opcional). Sin DSN la API arranca igual y los errores
# quedan solo en el log de Render.
SENTRY_DSN=

# Pedidos por minuto y por IP (opcionales, estos son los valores por defecto).
# `SIN_SESION` es POST /gastos/parsear, el único endpoint que no pide sesión.
# `CON_SESION` son las rutas de gastos. `SALUD` es /health/db, que consulta la
# base; /health no se limita porque es el keep-alive de Render.
LIMITE_SIN_SESION=30
LIMITE_CON_SESION=120
LIMITE_SALUD=10
